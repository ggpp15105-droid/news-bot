# ============================================================================
# news-bot — пример окружения.
# Скопируйте в .env и заполните. Значения ниже — дефолты бота.
# Переменные без значения выключены по умолчанию.
# ============================================================================

# --- Обязательные -----------------------------------------------------------
BOT_TOKEN=
CHANNEL_ID=@my_channel
ADMIN_ID=

# --- Расписание и объём -----------------------------------------------------
DIGEST_HOURS=8,20              # часы дайджестов по МСК; off — выключить
QUIET_HOURS=23-8               # тихие часы; off — выключить
BREAKING_AT_NIGHT=false        # breaking-новости ночью (без звука)
WEEKLY_RECAP=false
WEEKLY_RECAP_DAY=6             # 0=пн … 6=вс
WEEKLY_RECAP_HOUR=12
WEEKLY_RECAP_ITEMS=10

MAX_POSTS_PER_RUN=2
MAX_PER_SOURCE_PER_RUN=1
MAX_PER_CATEGORY_PER_RUN=2
MAX_POSTS_PER_DAY=60
MAX_POSTS_PER_HOUR=6
MAX_PER_SOURCE_PER_DAY=12
MAX_PER_SOURCE_FETCH=8
FRESHNESS_HOURS=30
MIN_SCORE=0.0
POST_DELAY=3.0

# --- Дедупликация и качество ------------------------------------------------
DEDUP_CONTAINMENT=0.62
DEDUP_JACCARD=0.55
TITLE_TRANSLATE_LIMIT=30
LLM_TITLE_BUDGET=8
EMBEDDING_MIN_SIMILARITY=0.86
EDIT_UPDATES=true
MAX_UPDATES_PER_CLUSTER=3
UPDATE_MIN_INTERVAL_MIN=10
CONFIRMATION_LABEL=true
TRANSLATION_NOTE=true
FEEDBACK_BUTTONS=false
FEEDBACK_WEIGHT=0.10
SOURCE_BUTTONS=true            # кнопки «🔗 Источник» под постом
OPINION_LABEL=true
# SKIP_PATTERNS=["\\bhow to watch\\b","\\bhoroscope\\b"]

# --- Перевод и LLM ----------------------------------------------------------
TRANSLATE_CHAIN=llm,deepl,yandex,google,mymemory,argos
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TRANSLATE_MODEL=gpt-4o-mini
SUMMARY_MODEL=
EMBEDDING_MODEL=
LLM_SUMMARY=true
LLM_TIMEOUT=45
DEEPL_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
MM_EMAIL=
GLOSSARY_FILE=glossary.txt
TRANSLATE_CACHE_SIZE=1200
EMBEDDING_CACHE_SIZE=600

# --- Ленты и маршрутизация --------------------------------------------------
DISABLED_FEEDS=
# EXTRA_FEEDS={"Хабр":"https://habr.com/ru/rss/news/","Наука":{"url":"https://nplus1.ru/rss","category":"наука","weight":1.0}}
# SOURCE_WEIGHTS={"BBC World":1.2,"Lenta.ru":2.0}
# CHANNEL_ROUTES={"игры":"@games_channel","спорт":"-1001234567890"}

# --- Состояние --------------------------------------------------------------
STATE_FILE=state.json
# STATE_REDIS_URL=https://your-instance.upstash.io
# STATE_REDIS_TOKEN=
STATE_REDIS_KEY=newsbot:state
KEEP_DAYS=7
MAX_STATE_POSTS=5000

# --- Админка и служебное ----------------------------------------------------
ADMIN_COMMANDS=true
ADMIN_POLL_TIMEOUT=0
ALERT_COOLDOWN_H=6
HEARTBEAT_URL=

# --- Сеть и устойчивость ----------------------------------------------------
FEED_DISABLE_AFTER_FAILS=5
FEED_DISABLE_HOURS=6
FEED_EMPTY_ALERT_STREAK=8
FETCH_TIMEOUT=25
TELEGRAM_TIMEOUT=30
MEDIA_PHOTO_MAX_MB=10
MEDIA_VIDEO_MAX_MB=45

# --- Отладка ----------------------------------------------------------------
DRY_RUN=false
LOG_LEVEL=INFO
